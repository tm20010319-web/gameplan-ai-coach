OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen3-vl:8b-instruct
# Knowledge chat: local semantic passage selection; no external call for local hits.
OLLAMA_CHAT_MODEL=qwen3-vl:4b-instruct
# Local live-skill diagnostic archives; start-monitor.ps1 defaults this to 1.
# 0 disables recording. Rotation: 32 batches / 128 MB / 30 minutes during use.
GAMEPLAN_SKILL_DIAGNOSTICS=1
# Text coaching: deepseek, qwen, or doubao. Empty overrides use provider defaults.
COACH_PROVIDER=deepseek
COACH_BASE_URL=
COACH_MODEL=
COACH_API_KEY=
# qwen: DASHSCOPE_API_KEY; doubao: ARK_API_KEY and COACH_MODEL required.
DASHSCOPE_API_KEY=
ARK_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_VISION_MODEL=deepseek-v4-pro
PUBLIC_BASE_URL=
COACH_FONT=C:/Windows/Fonts/msyh.ttc
# Unified PostgreSQL. When set, new chat/review/profile data never falls back to SQLite.
GAMEPLAN_DATABASE_URL=
GAMEPLAN_REDIS_URL=
GAMEPLAN_REDIS_PREFIX=gameplan:v1
GAMEPLAN_LOCAL_REDIS=0
# Local development only; remove on the server and attach a trusted login resolver.
GAMEPLAN_DEV_USER_ID=
# Start this project's portable PostgreSQL from start-monitor.ps1 when needed.
GAMEPLAN_LOCAL_POSTGRES=0
GAMEPLAN_ASSET_DIR=
