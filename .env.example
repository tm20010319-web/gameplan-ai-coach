OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen3-vl:8b-instruct
# Local live-skill diagnostic archives; start-monitor.ps1 defaults this to 1.
# 0 disables recording. Rotation: 32 batches / 128 MB / 30 minutes during use.
GAMEPLAN_SKILL_DIAGNOSTICS=1
# Text coaching: deepseek, qwen, or doubao. Empty overrides use provider defaults.
COACH_PROVIDER=deepseek
COACH_BASE_URL=
COACH_MODEL=
COACH_API_KEY=
# qwen: DASHSCOPE_API_KEY; doubao: ARK_API_KEY and COACH_MODEL required.
DASHSCOPE_API_KEY=
ARK_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_VISION_MODEL=deepseek-v4-pro
PUBLIC_BASE_URL=
COACH_FONT=C:/Windows/Fonts/msyh.ttc
